# Electron desktop shell packaging output (build/ icons are product assets and
# are committed; release/ is regenerated by electron-builder, and the bundled
# helper Node binary is fetched by the fetch-node script). Probe builds and
# silent-install extraction probes are scratch outputs, never committed.
apps/desktop/release/
apps/desktop/release-*/
apps/desktop/install-probe-*/
apps/desktop/node_modules/
apps/desktop/build/node/

# Windows reserved device name artifacts (never committable; reject if seen)
NUL

# Local scratch/debug dumps under .zcode/ and repo root
.zcode/tmp-*.txt
tmp-*-dump.txt
tmp-*.txt

tmp-inspect-*.mjs

# Local build debug logs
build-output*.log

# Stale tsc emit inside src/ (correct output goes to lib/)
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map

# Temporary scratch directories
tmp-pack-scan/
**/temp-test/

# Added during safe-commit pass: exclude local agent memory scratch
.workbuddy/
