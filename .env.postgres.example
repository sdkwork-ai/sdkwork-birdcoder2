# Workspace PostgreSQL profile template (SDKWORK_DATABASE_* only).
#
# Copy to `.env.postgres` (gitignored) and fill in the local platform database
# credentials. `pnpm run iam:ensure` provisions this repository's runtime
# applications into the IAM tenant application registry through this profile;
# the IAM bootstrap rejects any key here that is not `SDKWORK_DATABASE_*`.
# An exported `SDKWORK_DATABASE_URL` (or `SDKWORK_DATABASE_HOST` plus
# `SDKWORK_DATABASE_NAME`) takes precedence and needs no file at all.
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=change-me
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_DATABASE_URL=postgres://sdkwork_ai_dev:change-me@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable&options=-c%20search_path%3Dsdkwork_ai_dev
