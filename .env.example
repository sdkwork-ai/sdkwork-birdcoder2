# SDKWork env template — canonical profile: standalone.development
#
# Per sdkwork-specs ENVIRONMENT_SPEC.md section 5.1, materialized env files are
# named by the canonical profile id <deploymentProfile>.<environment>; the
# tracked materializations are `.env.standalone.development`,
# `.env.standalone.test`, and `.env.standalone.production`. Copy the file
# matching your target environment to `.env` at the repo root for local runs —
# the dsh boot loader (packages/boot/app-boot, loadLayeredEnv) reads the
# invoking directory's `.env` and the Harness-home `.env`, never profile-
# suffixed files. `pnpm env:token:ensure` (also `pnpm build` / `pnpm desktop:dev`)
# generates the bootstrap access token for development/test into the gitignored
# `.env.standalone.<environment>.bootstrap.local` overlay; production tokens
# come from a secret manager.
#
# SDKWork gateway origins follow the product domain: development uses
# http://api-dev.birdcoder.com, every non-production tier uses the
# api-<tier>.birdcoder.com form, and production uses the bare
# https://api.birdcoder.com (SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL
# below; the ui-env schema defaults mirror the same three values).
#
# Tracked templates carry placeholders only; never commit live credentials.
# Local overrides (.env.local, .env.*.local, .env.*.bootstrap.local) are
# gitignored per section 5.1.7.

# --- SDKWork identity keys (section 5.1.2) ---
# The materialized file declares its own profile; rewriting a deployment means
# changing these together with the file name.
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.development
# server (CLI/headless/container), desktop (Electron), or browser (web).
SDKWORK_RUNTIME_TARGET=server
SDKWORK_BIRDCODER_ENVIRONMENT=development
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_PROFILE_ID=standalone.development
SDKWORK_BIRDCODER_RUNTIME_TARGET=server

# --- SDKWork surface URLs (section 6) ---
# Standalone development: the application ingress is the local dev host; the
# platform API gateway is the development gateway origin
# (api-<tier>.birdcoder.com off production).
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:10240
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=http://api-dev.birdcoder.com

# --- Bootstrap credential (section 6.1) ---
# Signed SDKWork access token seeding non-interactive app-api/backend-api calls
# (ui-env profile accessToken, consumed by ui-iam and ui-feedback). Must be a
# signed JWT carrying tenant/app/environment claims; leave empty to defer to
# interactive IAM login. Never browser-visible, never committed.
SDKWORK_ACCESS_TOKEN=

# --- Product provider keys ---
# Empty placeholders disable the corresponding provider. Fill the ignored
# `.env` copy or export in the launch environment; never commit real values.
DEEPSEEK_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
E2B_API_KEY=
# OpenAI-compatible relay routes seeded in the pi-ai provider catalog
# (packages/llm/llm-pi-ai); store a key under the derived reference.
SDKWORK_API_KEY=
BIRDCODER_API_KEY=

# --- Launch-environment-only variables ---
# The boot loader rejects these names in a `.env` file because they decide how
# the process starts, where its code and instructions load from, or how it
# reaches the network. Export them in the shell that starts dsh instead:
#   DEEPSEEK_BASE_URL=            # optional DeepSeek-compatible endpoint
#   DEEPSEEK_SEARCH_BASE_URL=
#   DSH_HOME=                     # Harness home; its `.env` is the user layer
#   DSH_AGENTS_HOME=
#   DSH_BUNDLED_SKILL_DIR=
#   DSH_WEB_HOST= DSH_WEB_PORT= DSH_ALLOW_NON_LOOPBACK= DSH_TRUSTED_HOSTS=
#   DSH_TELEMETRY_DISABLED=
#   DSH_WEB_SEARCH_PROVIDER= DSH_WEB_FETCH_PROVIDER=
#   HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=
#   NODE_TLS_REJECT_UNAUTHORIZED=
