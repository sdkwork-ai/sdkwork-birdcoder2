# BirdCoder2 standalone.production runtime template (safe example, no secrets).
# Installed authority: /etc/sdkwork/birdcoder2/config.toml (APPLICATION_DEPLOY_LAYOUT_SPEC.md).
# Host-local overrides are excluded from source control.

[server]
bind = "127.0.0.1:7780"
environment = "production"
deployment_profile = "standalone"

[logging]
level = "info"
format = "json"
