# Safe example: tablet renderer build env for cloud.production / tablet-ipados.
# Public VITE_* values only. No tokens, secrets, database, or Redis settings.
VITE_SDKWORK_APPLICATION_CODE=birdcoder2
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=https://harness.sdkwork.com
VITE_SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_BIRDCODER_ENVIRONMENT=production
VITE_SDKWORK_BIRDCODER_PROFILE_ID=cloud.production
VITE_SDKWORK_BIRDCODER_RUNTIME_TARGET=tablet-ipados
VITE_SDKWORK_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_ENVIRONMENT=production
VITE_SDKWORK_PROFILE_ID=cloud.production
VITE_SDKWORK_RUNTIME_TARGET=tablet-ipados
VITE_SDKWORK_SURFACE=pad