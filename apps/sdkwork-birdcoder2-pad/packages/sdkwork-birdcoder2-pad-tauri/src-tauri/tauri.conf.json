{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BirdCoder2 Pad",
  "version": "0.1.0",
  "identifier": "com.sdkwork.birdcoder2.pad",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BirdCoder2 Pad",
        "width": 1024,
        "height": 768,
        "minWidth": 600,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "ios",
      "android"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "frameworks": []
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}