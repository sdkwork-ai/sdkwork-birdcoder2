  "integration": {
    "hostAuthority": "The host registry and pairing codes are owned by the sdkwork-birdcoder2 host runtime service; this package reads and writes them exclusively through the BirdCoder2 app API ports exposed by H5 core, never through a generated SDK.",
    "platformBoundary": "Clipboard and secure storage come from the bound host adapters in H5 core, so the same screen runs in a browser, a WebView, and the Capacitor shell without importing a platform global."
