# SDKWork materialized env — canonical profile: cloud.production
#
# Deployment profile `cloud` (sdkwork-specs ENVIRONMENT_SPEC.md 5.1): the
# application reaches the SDKWork cloud edge by domain — the platform API
# gateway is https://api.sdkwork.com and the application public ingress is
# https://harness.sdkwork.com. Values mirror etc/topology/cloud.production.env.
#
# The Web build is its single reader: `apps/web/vite.config.ts` loads it with
# Vite's `loadEnv` for the `production` build mode (the default deployment profile is
# `cloud`) and injects the gateway, app identity, and bootstrap credential into
# the built page. One build targets exactly one environment; `.env` sits below
# this file for local values.
#
# FORK DIVERGENCE: this file is committed with a live token (copied from
# `.env.standalone.production`). Refresh it after `pnpm env:token:ensure
# --environment production`, commit, and rebuild.
# --- SDKWork identity keys (section 5.1.2) ---
# The materialized file declares its own profile; rewriting a deployment means
# changing these together with the file name.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROFILE_ID=cloud.production
# server (CLI/headless/container), desktop (Electron), or browser (web).
SDKWORK_RUNTIME_TARGET=server
SDKWORK_BIRDCODER_ENVIRONMENT=production
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BIRDCODER_PROFILE_ID=cloud.production
SDKWORK_BIRDCODER_RUNTIME_TARGET=server

# --- SDKWork surface URLs (section 6) ---
# Production: the application ingress host is deployment-specific (unset
# here); the platform API gateway is the bare production gateway origin.
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=https://harness.sdkwork.com
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_IM_API_BASE_URL=https://api.sdkwork.com
# The Web build ships the IM embed bundle at this root-relative route
# (apps/web/public/sdkwork-im/im-pc-embed.js), so a packaged or hosted
# deployment mounts the IM surfaces from its own origin instead of requiring a
# separately deployed bundle.
SDKWORK_IM_EMBED_URL=/sdkwork-im/im-pc-embed.js

# --- Bootstrap credential (section 6.1) ---
# Signed SDKWork access token seeding non-interactive app-api/backend-api calls
# (ui-env profile accessToken, consumed by ui-iam and ui-feedback). The startup
# ensure step never generates a production token, and an empty value defers to
# interactive IAM login. This tracked value is the release lane's credential
# source (see the header), so it is committed for this fork rather than kept in
# a secret manager. Never browser-visible.
SDKWORK_ACCESS_TOKEN=eyJhbGciOiJub25lIiwia2lkIjoicHVibGljLWFwcC10b2tlbiIsInR5cCI6IkpXVCJ9..public

# --- Product provider keys ---
# Empty placeholders disable the corresponding provider. Fill the ignored
# `.env` copy or export in the launch environment; never commit real values.
DEEPSEEK_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
E2B_API_KEY=
# OpenAI-compatible relay routes seeded in the pi-ai provider catalog
# (packages/llm/llm-pi-ai); store a key under the derived reference.
SDKWORK_API_KEY=
BIRDCODER_API_KEY=

# --- Launch-environment-only variables ---
# The boot loader rejects these names in a `.env` file because they decide how
# the process starts, where its code and instructions load from, or how it
# reaches the network. Export them in the shell that starts dsh instead:
#   DEEPSEEK_BASE_URL=            # optional DeepSeek-compatible endpoint
#   DEEPSEEK_SEARCH_BASE_URL=
#   DSH_HOME=                     # Harness home; its `.env` is the user layer
#   DSH_AGENTS_HOME=
#   DSH_BUNDLED_SKILL_DIR=
#   DSH_WEB_HOST= DSH_WEB_PORT= DSH_ALLOW_NON_LOOPBACK= DSH_TRUSTED_HOSTS=
#   DSH_TELEMETRY_DISABLED=
#   DSH_WEB_SEARCH_PROVIDER= DSH_WEB_FETCH_PROVIDER=
#   HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=
#   NODE_TLS_REJECT_UNAUTHORIZED=

# Deployment identity of the packaged application (non-secret; the token stays in the
# user-private credential bundle).
SDKWORK_APP_ID=app_01a18b4f-6f61-7ff1-b86c-75b54995883f
SDKWORK_TENANT_ID=100001
SDKWORK_ORGANIZATION_ID=0
SDKWORK_APP_DOMAIN=api.sdkwork.com
SDKWORK_TENANT_APPLICATION_ID=tapp_100001_0_01a18b4f_6eed_7fd1_beca_780a4c7a8d66
