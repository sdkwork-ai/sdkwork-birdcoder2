[submodule "plugins/dsh-im"]
	path = plugins/dsh-im
	url = https://github.com/xmanrui/dsh-im
	# Advance the pin with `git submodule update --remote plugins/dsh-im`,
	# which follows this branch; the committed gitlink stays the release pin.
	branch = main
[submodule "plugins/dsh-better-sidebar"]
	path = plugins/dsh-better-sidebar
	url = https://github.com/omdsh-dev/DSH-better-sidebar.git
	branch = dev
[submodule "plugins/dsh-skill-market"]
	path = plugins/dsh-skill-market
	url = https://github.com/montersy123/dsh-skill-market.git
	# Advance the pin with `git submodule update --remote plugins/dsh-skill-market`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v2.0.7 tag, whose built `lib/` artifacts ship as committed).
	branch = main
[submodule "plugins/dsh-mcp-connector"]
	path = plugins/dsh-mcp-connector
	url = https://github.com/duhu2000/dsh-mcp-connector.git
	# Advance the pin with `git submodule update --remote plugins/dsh-mcp-connector`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v0.2.94 tag, whose built `lib/` artifacts and `ui/` panel
	# ship as committed).
	branch = main
[submodule "plugins/dsh-ui-usage-billing"]
	path = plugins/dsh-ui-usage-billing
	# SDKWork fork of kenz1117/dsh-ui-usage-billing. This fork OWNS the plugin:
	# the usage card is hidden by default and re-mounted inside the settings menu
	# (under the account identity) through the `settings.menu.account` seat, so
	# local fixes land here instead of upstream. SSH is required because the
	# repository is private to the org.
	url = git@github.com:sdkwork-ai/sdkwork-dsh-usage-billing.git
	# Advance the pin with `git submodule update --remote plugins/dsh-ui-usage-billing`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the fork's own release commit, whose built `lib/` artifacts ship
	# as committed).
	branch = main
[submodule "sdkwork-deepseekbot"]
	path = plugins/sdkwork-deepseekbot
	# SDKWork's BotHarness mirror, and the plugin's upstream for this fork: the
	# assistant surface (Bot registry, memory, channels, the Bot-mode UI) is
	# edited there, built from source here, and pinned by this gitlink. Unlike
	# the read-only plugins above, its `lib/`/`dist/` are gitignored upstream,
	# so this repository builds them (`pnpm run build:deepseekbot`) instead of
	# running committed artifacts.
	url = git@github.com:sdkwork-ai/sdkwork-deepseekbot.git
	# Advance the pin with `git submodule update --remote plugins/sdkwork-deepseekbot`.
	branch = main
	shallow = true
