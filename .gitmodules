[submodule "plugins/dsh-im"]
	path = plugins/dsh-im
	url = https://github.com/xmanrui/dsh-im
	# Advance the pin with `git submodule update --remote plugins/dsh-im`,
	# which follows this branch; the committed gitlink stays the release pin.
	branch = main
[submodule "plugins/dsh-better-sidebar"]
	path = plugins/dsh-better-sidebar
	url = https://github.com/omdsh-dev/DSH-better-sidebar.git
	branch = dev
[submodule "plugins/dsh-skill-market"]
	path = plugins/dsh-skill-market
	url = https://github.com/montersy123/dsh-skill-market.git
	# Advance the pin with `git submodule update --remote plugins/dsh-skill-market`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v2.0.7 tag, whose built `lib/` artifacts ship as committed).
	branch = main
[submodule "plugins/dsh-mcp-connector"]
	path = plugins/dsh-mcp-connector
	url = https://github.com/duhu2000/dsh-mcp-connector.git
	# Advance the pin with `git submodule update --remote plugins/dsh-mcp-connector`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v0.2.117 tag, whose built `lib/` artifacts and `ui/` panel
	# ship as committed).
	branch = main
[submodule "plugins/dsh-ui-usage-billing"]
	path = plugins/dsh-ui-usage-billing
	# SDKWork fork of kenz1117/dsh-ui-usage-billing. This fork OWNS the plugin:
	# the usage card is hidden by default and re-mounted inside the settings menu
	# (under the account identity) through the `settings.menu.account` seat, so
	# local fixes land here instead of upstream. SSH is required because the
	# repository is private to the org.
	url = git@github.com:sdkwork-ai/sdkwork-dsh-usage-billing.git
	# Advance the pin with `git submodule update --remote plugins/dsh-ui-usage-billing`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the fork's own `1.8.8-sdkwork.1` release commit, whose built
	# `lib/` artifacts ship as committed).
	branch = main
[submodule "sdkwork-deepseekbot"]
	path = plugins/sdkwork-deepseekbot
	# SDKWork's BotHarness mirror, and the plugin's upstream for this fork: the
	# assistant surface (Bot registry, memory, channels, the Bot-mode UI) is
	# edited there, built from source here, and pinned by this gitlink. Unlike
	# the read-only plugins above, its `lib/`/`dist/` are gitignored upstream,
	# so this repository builds them (`pnpm run build:deepseekbot`) instead of
	# running committed artifacts.
	url = git@github.com:sdkwork-ai/sdkwork-deepseekbot.git
	# Advance the pin with `git submodule update --remote plugins/sdkwork-deepseekbot`.
	branch = main
	shallow = true
[submodule "plugins/sdkwork-dsh-agents"]
	path = plugins/sdkwork-dsh-agents
	# SDKWork's expert-market mirror (`@michengai/dsh-agency-agents`): the 331
	# expert roster and expert teams the Experts tab embeds as its market chip.
	# The mirror is the authority for the plugin's source and build; its `lib/`
	# artifacts ship as committed, so this repository runs them instead of
	# rebuilding. SSH is required because the repository is private to the org.
	url = git@github.com:sdkwork-ai/sdkwork-dsh-agents.git
	# Advance the pin with `git submodule update --remote plugins/sdkwork-dsh-agents`
	# (`pnpm run update:expert-market` also relinks and runs the acceptance spec),
	# which follows this branch; the committed gitlink stays the release pin.
	branch = main
[submodule "plugins/dsh-market"]
	path = plugins/dsh-market
	# SDKWork's fork of `dsh-market/dsh-market` (npm `dshmarket`): the plugin
	# market the web bundle mounts as the Plugins tab's leading chip. The fork
	# is the authority for the plugin's source and future product changes, so
	# local fixes land there instead of upstream. Its `client/client.js` ships
	# committed; its host half `lib/` is gitignored upstream, so this repository
	# builds that half (`pnpm run build:dsh-market`) instead of rebuilding the
	# whole plugin. The plugin's own `prepare` must stay the emit-only `tsc`
	# (`--noCheck`) that the fork's `b7d62fd` set: a type-checked build resolves
	# `@deepseek-ai/cordis` and `@deepseek-ai/schemastery` through
	# `vendor/*/lib/types`, which a fresh clone has not compiled yet, so
	# `pnpm install` died on TS2307 before any lane could build. The repository
	# is public, so the gitlink clones over HTTPS like the upstream-owned
	# entries and CI needs no deploy key.
	url = https://github.com/sdkwork-ai/sdkwork-dsh-market.git
	# Advance the pin with `git submodule update --remote plugins/dsh-market`,
	# which follows this branch; the committed gitlink stays the release pin.
	branch = main
	shallow = true
