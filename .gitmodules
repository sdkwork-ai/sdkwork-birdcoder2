[submodule "plugins/dsh-im"]
	path = plugins/dsh-im
	url = https://github.com/xmanrui/dsh-im
	# Advance the pin with `git submodule update --remote plugins/dsh-im`,
	# which follows this branch; the committed gitlink stays the release pin.
	branch = main
[submodule "plugins/dsh-better-sidebar"]
	path = plugins/dsh-better-sidebar
	url = https://github.com/omdsh-dev/DSH-better-sidebar.git
	branch = dev
[submodule "plugins/dsh-skill-market"]
	path = plugins/dsh-skill-market
	url = https://github.com/montersy123/dsh-skill-market.git
	# Advance the pin with `git submodule update --remote plugins/dsh-skill-market`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v2.0.7 tag, whose built `lib/` artifacts ship as committed).
	branch = main
[submodule "plugins/dsh-mcp-connector"]
	path = plugins/dsh-mcp-connector
	url = https://github.com/duhu2000/dsh-mcp-connector.git
	# Advance the pin with `git submodule update --remote plugins/dsh-mcp-connector`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v0.2.94 tag, whose built `lib/` artifacts and `ui/` panel
	# ship as committed).
	branch = main
[submodule "plugins/sdkwork-dsh-bot"]
	path = plugins/sdkwork-dsh-bot
	# SDKWork's fork of DS Bot. The plugin package is the repository's `ds-bot/`
	# directory, not its root, so the pnpm member is `plugins/sdkwork-dsh-bot/ds-bot`.
	url = https://github.com/sdkwork-ai/sdkwork-dsh-bot.git
	# Advance the pin with `git submodule update --remote plugins/sdkwork-dsh-bot`,
	# which follows this branch; the committed gitlink stays the release pin
	# (currently the v0.3.1 release merge, whose built `client.js` ships as
	# committed).
	branch = main
[submodule "plugins/sdkwork-dsh-bot"]
	path = plugins/sdkwork-dsh-bot
	url = https://github.com/sdkwork-ai/sdkwork-dsh-bot.git
