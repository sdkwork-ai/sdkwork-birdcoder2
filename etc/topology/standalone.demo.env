# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_birdcoder2_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_birdcoder2_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_BIRDCODER_PROFILE_ID=standalone.demo
SDKWORK_BIRDCODER_ALLOWED_ORIGINS=http://127.0.0.1:7780,http://localhost:7780
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:7780,http://localhost:7780,https://harness-demo.sdkwork.com,http://harness-demo.sdkwork.com,https://harness-demo.birdcoder.com,http://harness-demo.birdcoder.com,https://harness-demo.dtupay.com,http://harness-demo.dtupay.com,https://harness-demo.noaper.com,http://harness-demo.noaper.com,https://harness-demo.sdkwork.cn,http://harness-demo.sdkwork.cn,https://harness-demo.birdcoder.cn,http://harness-demo.birdcoder.cn,https://harness-demo.dtupay.cn,http://harness-demo.dtupay.cn,https://harness-demo.noaper.cn,http://harness-demo.noaper.cn,https://harness-demo.skubc.com,http://harness-demo.skubc.com,https://harness-demo.skubc.cn,http://harness-demo.skubc.cn,https://harness-demo.zowalk.com,http://harness-demo.zowalk.com,https://harness-demo.zowalk.cn,http://harness-demo.zowalk.cn,https://harness-demo.offer86.com,http://harness-demo.offer86.com,https://harness-demo.offer86.cn,http://harness-demo.offer86.cn,https://harness-demo.86offer.com,http://harness-demo.86offer.com,https://harness-demo.86offer.cn,http://harness-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_ENVIRONMENT=demo
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:7780
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:7780
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:7780
SDKWORK_BIRDCODER_DESKTOP_DEV_BIND=127.0.0.1:0
SDKWORK_APP_ROOT=.
SDKWORK_BIRDCODER_APP_ROOT=.


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BIRDCODER2_REGION_CODE=global
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
