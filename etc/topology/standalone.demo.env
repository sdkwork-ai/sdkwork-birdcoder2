# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_birdcoder2_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_birdcoder2_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_BIRDCODER_PROFILE_ID=standalone.demo
SDKWORK_BIRDCODER_ALLOWED_ORIGINS=http://127.0.0.1:7780,http://localhost:7780
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:7780,http://localhost:7780
SDKWORK_ENVIRONMENT=demo
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:7780
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:7780
VITE_SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:7780
SDKWORK_BIRDCODER_DESKTOP_DEV_BIND=127.0.0.1:0
SDKWORK_APP_ROOT=.
SDKWORK_BIRDCODER_APP_ROOT=.
