# SDKWork materialized env — canonical profile: standalone.production
#
# Per sdkwork-specs ENVIRONMENT_SPEC.md section 5.1, materialized env files are
# named by the canonical profile id <deploymentProfile>.<environment>. This file
# is the tracked materialization of the production tier.
#
# The build default is the `cloud` profile (`.env.cloud.production`); this file is
# the standalone twin, read only when `DSH_WEB_DEPLOYMENT_PROFILE=standalone`.
#
# The Web build is its single reader: `apps/web/vite.config.ts` loads it with
# Vite's `loadEnv` for the `production` build mode and injects this deployment's
# gateway, app identity, and `SDKWORK_ACCESS_TOKEN` into the built page. There is
# no packaging-time projection and no `resources/sdkwork-release.env`; one build
# targets exactly one environment, and `.env` sits below this file for local
# values. `pnpm env:token:resolve` validates the token before a build.
#
# The bootstrap token below is a placeholder anchored on
# `__SDKWORK_DEPLOY_APPLICATION_ID__`, not a live credential: the deploy
# application id belongs to the installation, so `apps/web/vite.config.ts`
# injects it at build time from `SDKWORK_DEPLOY_APPLICATION_ID` and fails the
# build when it is missing (see README.md).

# --- SDKWork identity keys (section 5.1.2) ---
# The materialized file declares its own profile; rewriting a deployment means
# changing these together with the file name.
SDKWORK_ENVIRONMENT=production
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.production
# server (CLI/headless/container), desktop (Electron), or browser (web).
SDKWORK_RUNTIME_TARGET=server
SDKWORK_BIRDCODER_ENVIRONMENT=production
SDKWORK_BIRDCODER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BIRDCODER_PROFILE_ID=standalone.production
SDKWORK_BIRDCODER_RUNTIME_TARGET=server

# --- SDKWork surface URLs (section 6) ---
# Production: the application ingress host is deployment-specific (unset
# here); the platform API gateway is the bare production gateway origin.
SDKWORK_BIRDCODER_APPLICATION_PUBLIC_HTTP_URL=
SDKWORK_BIRDCODER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.birdcoder.com
# The Web build ships the IM embed bundle at this root-relative route
# (apps/web/public/sdkwork-im/im-pc-embed.js), so a packaged or hosted
# deployment mounts the IM surfaces from its own origin instead of requiring a
# separately deployed bundle.
SDKWORK_IM_EMBED_URL=/sdkwork-im/im-pc-embed.js

# --- Bootstrap credential (section 6.1) ---
# Public SDKWork application access token seeding non-interactive
# app-api/backend-api calls (ui-env profile accessToken, consumed by ui-iam and
# ui-feedback). This file cannot know the installation's deploy application id,
# so the committed value is the deterministic
# '__SDKWORK_DEPLOY_APPLICATION_ID__' placeholder token:
# `apps/web/vite.config.ts` substitutes the anchor at build time and fails the
# build when neither `SDKWORK_DEPLOY_APPLICATION_ID` nor a real token is
# supplied (see `.env.example` and README.md). An empty value still defers to
# interactive IAM login, and a local untracked `.env.local` may carry real
# values instead. Never browser-visible; never a live credential here.
SDKWORK_ACCESS_TOKEN=eyJhbGciOiJub25lIiwia2lkIjoicHVibGljLWFwcC10b2tlbiIsInR5cCI6IkpXVCJ9..public

# --- Product provider keys ---
# Empty placeholders disable the corresponding provider. Fill the ignored
# `.env` copy or export in the launch environment; never commit real values.
DEEPSEEK_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
E2B_API_KEY=
# OpenAI-compatible relay routes seeded in the pi-ai provider catalog
# (packages/llm/llm-pi-ai); store a key under the derived reference.
SDKWORK_API_KEY=
BIRDCODER_API_KEY=

# --- Launch-environment-only variables ---
# The boot loader rejects these names in a `.env` file because they decide how
# the process starts, where its code and instructions load from, or how it
# reaches the network. Export them in the shell that starts dsh instead:
#   DEEPSEEK_BASE_URL=            # optional DeepSeek-compatible endpoint
#   DEEPSEEK_SEARCH_BASE_URL=
#   DSH_HOME=                     # Harness home; its `.env` is the user layer
#   DSH_AGENTS_HOME=
#   DSH_BUNDLED_SKILL_DIR=
#   DSH_WEB_HOST= DSH_WEB_PORT= DSH_ALLOW_NON_LOOPBACK= DSH_TRUSTED_HOSTS=
#   DSH_TELEMETRY_DISABLED=
#   DSH_WEB_SEARCH_PROVIDER= DSH_WEB_FETCH_PROVIDER=
#   HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=
#   NODE_TLS_REJECT_UNAUTHORIZED=

# Deployment identity of the packaged application (non-secret; the token stays in the
# user-private credential bundle).
# Deploy application anchor, injected at build time (see the header comment).
SDKWORK_APP_ID=__SDKWORK_DEPLOY_APPLICATION_ID__
SDKWORK_TENANT_ID=100001
SDKWORK_ORGANIZATION_ID=0
SDKWORK_APP_DOMAIN=api.birdcoder.com
SDKWORK_TENANT_APPLICATION_ID=tapp_100001_0_01a18b4f_6eed_7fd1_beca_780a4c7a8d66
