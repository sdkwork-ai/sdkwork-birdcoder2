{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The full typecheck project: checks this package's own code AND the
    // composed BirdCoder2 App SDK its installation read is built on. The emit
    // project resolves that SDK through the workspace source alias without
    // re-checking it; this project drops the relaxed flags so the package and
    // its specs are checked against it.
    //
    // The include names the composed consumer facade only: the generated
    // transport is reached through the facade's imports, never through a second
    // include entry (`check-app-sdk-consumer-imports.mjs` rejects a consumer
    // that aliases the transport directly).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "types": ["node"],
    "rootDir": "../../..",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {}
  },
  "include": [
    "src",
    "tests",
    "../../../sdks/sdkwork-birdcoder2-app-sdk/sdkwork-birdcoder2-app-sdk-typescript/src"
  ]
}
