{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The generated BirdCoder2 App SDK enters this program as external source
    // (its composed entry imports the generator-owned transport), written for
    // the SDKWork flag set rather than this repository's stricter one. The
    // package's own code still follows the harness conventions; its behavior is
    // covered by the package specs.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "noCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../ui-settings/tsconfig.client.json"
    },
    {
      "path": "../ui-renderer"
    },
    {
      "path": "../locale/tsconfig.client.json"
    },
    {
      "path": "../ui-sdkwork-env/tsconfig.client.json"
    },
    {
      "path": "../ui-sdkwork-iam"
    },
    {
      "path": "../ui-layout"
    }
  ]
}
