{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // This no-emit program checks the real sibling source and catches drift in
    // the host ports, generated clients, and embedded Drive surface.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "types": ["node"],
    "rootDir": "../../../..",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    // SDKWork packages use React 19 types. A single type identity keeps JSX
    // assignability coherent while BirdCoder still supplies React 18 at runtime.
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-drive/src",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-core/src",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-file/src",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-commons/src",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-transfer/src",
    "../../../../sdkwork-drive/apps/sdkwork-drive-pc/packages/sdkwork-drive-pc-types/src",
    "../../../../sdkwork-drive/sdks/sdkwork-drive-app-sdk/sdkwork-drive-app-sdk-typescript/src",
    "../../../../sdkwork-drive/sdks/sdkwork-drive-app-sdk/sdkwork-drive-app-sdk-typescript/generated/server-openapi/src",
    "../../../../sdkwork-drive/sdks/sdkwork-drive-app-sdk/sdkwork-drive-app-sdk-typescript/composed",
    "../../../../sdkwork-utils/packages/sdkwork-utils-typescript/src",
    "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src"
  ],
  "exclude": [
    "../../../../sdkwork-*/**/*.test.ts",
    "../../../../sdkwork-*/**/*.test.tsx",
    "../../../../sdkwork-*/**/*.spec.ts",
    "../../../../sdkwork-*/**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    { "path": "../../../vendor/cordis" },
    { "path": "../locale" },
    { "path": "../runtime" },
    { "path": "../ui-app-modes" },
    { "path": "../ui-env" },
    { "path": "../ui-iam" },
    { "path": "../ui-layout" },
    { "path": "../ui-primitives" },
    { "path": "../ui-slots" },
    { "path": "../../runtime-diagnostics/invariants" }
  ]
}
