{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The sdkwork sibling packages enter this program as external source
    // (their manifests point exports at src). They are written for the
    // sdkwork flag set (strict only), so the harness's stricter flags are
    // relaxed for THIS project's program; the package's own code still
    // follows the harness conventions.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    // The sdkwork source is type-checked by the dedicated tests project
    // (tsconfig.tests.json) under the same relaxed flags; this project
    // resolves and emits declarations without re-checking the external
    // source.
    "noCheck": true,
    // TS 6.0 paths need baseUrl; ignoreDeprecations silences the 7.0
    // removal notice. The sdkwork imports resolve to the local declaration
    // facades (sdkwork-types/) so the emit program never pulls the sdkwork
    // source (whose closure cannot be emitted portably); the tests project
    // is the drift guard against the real packages.
    "paths": {
      "@sdkwork/appstore-app-sdk": ["./sdkwork-types/appstore-app-sdk.d.ts"],
      "@sdkwork/sdk-common": ["./sdkwork-types/sdk-common.d.ts"]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../ui-layout"
    },
    {
      "path": "../ui-env"
    },
    {
      "path": "../ui-settings"
    },
    {
      "path": "../ui-app-modes"
    },
    {
      "path": "../ui-settings-menu"
    },
    {
      "path": "../web-react"
    },
    {
      "path": "../locale"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
