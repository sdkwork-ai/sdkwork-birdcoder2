{
  // Bundle-time tsconfig for tsdown: strips the declaration-facade `paths`
  // (sdkwork-types/) so the client bundle resolves the REAL sdkwork package
  // through node_modules and inlines its source. Everything else inherits the
  // emit project's settings.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {}
  }
}
