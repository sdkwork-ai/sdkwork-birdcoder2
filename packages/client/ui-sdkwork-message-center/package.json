{
  "name": "@deepseek-ai/dsh-client-ui-sdkwork-message-center",
  "description": "SDKWork message center: the rail message shortcut and the message page it opens over the SDKWork app notification API",
  "version": "0.2.3-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sdkwork-message-center"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sdkwork-app-modes",
        "@deepseek-ai/dsh-client-ui-sdkwork-env",
        "@deepseek-ai/dsh-client-ui-sdkwork-iam"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-config": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sdkwork-app-modes": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sdkwork-env": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sdkwork-iam": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@sdkwork/sdk-common": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
