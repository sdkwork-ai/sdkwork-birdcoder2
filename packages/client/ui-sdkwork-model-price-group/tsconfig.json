{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The generated CloudRouter app SDK and the IAM token-manager subpath enter
    // this program as external sibling source (their manifests/aliases point at
    // src). They follow their own compiler flags, so the harness's stricter
    // flags are relaxed for THIS project's program; the package's own code is
    // still type-checked by the client test aggregate that imports it.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "noCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../locale/tsconfig.client.json"
    },
    {
      "path": "../store"
    },
    {
      "path": "../ui-model-selection"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../ui-renderer"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../ui-sdkwork-env/tsconfig.client.json"
    },
    {
      "path": "../ui-sdkwork-iam"
    },
    {
      "path": "../../api/session-controller/tsconfig.client.json"
    },
    {
      "path": "../../core/agent"
    },
    {
      "path": "../../core/session"
    }
  ]
}
