{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // SDKWork sibling packages enter this program as external source (their
    // manifests point exports at src). They are written for the sdkwork flag
    // set (strict only), so the harness's stricter flags are relaxed for THIS
    // project's program; the package's own code still follows the harness
    // conventions.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    // The sdkwork source is type-checked by the dedicated tests project
    // (tsconfig.tests.json) under the same relaxed flags; this project
    // resolves and emits declarations without re-checking the external
    // source.
    "noCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../ui-settings"
    },
    {
      "path": "../ui-theme"
    },
    {
      "path": "../ui-renderer"
    },
    {
      "path": "../locale"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../connection/tsconfig.client.json"
    },
    {
      "path": "../../api/remotes/tsconfig.client.json"
    },
    {
      "path": "../ui-sdkwork-app-modes"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
