{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "types": ["node"],
    "rootDir": "../../../..",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@sdkwork/course-app-sdk": ["../../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/src/index.ts"],
      "@sdkwork/course-app-sdk/*": ["../../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/src/*"],
      "@sdkwork/course-pc-course": ["../../../../sdkwork-course/apps/sdkwork-course-pc/packages/sdkwork-course-pc-course/src/index.ts"],
      "@sdkwork/course-pc-course/*": ["../../../../sdkwork-course/apps/sdkwork-course-pc/packages/sdkwork-course-pc-course/src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "../../../../sdkwork-course/apps/sdkwork-course-pc/packages/sdkwork-course-pc-course/src",
    "../../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/src",
    "../../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/composed",
    "../../../../sdkwork-course/sdks/sdkwork-course-app-sdk/sdkwork-course-app-sdk-typescript/generated/server-openapi/src",
    "../../../../sdkwork-utils/packages/sdkwork-utils-typescript/src",
    "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src"
  ],
  "exclude": [
    "../../../../sdkwork-*/**/*.test.ts",
    "../../../../sdkwork-*/**/*.test.tsx",
    "../../../../sdkwork-*/**/*.spec.ts",
    "../../../../sdkwork-*/**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    { "path": "../../../vendor/cordis" },
    { "path": "../locale" },
    { "path": "../runtime" },
    { "path": "../ui-sdkwork-app-modes" },
    { "path": "../ui-sdkwork-env" },
    { "path": "../ui-sdkwork-iam" },
    { "path": "../ui-layout" },
    { "path": "../ui-primitives" },
    { "path": "../ui-slots" },
    { "path": "../../runtime-diagnostics/invariants" }
  ]
}
