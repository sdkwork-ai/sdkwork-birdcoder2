{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Full typecheck project: checks this package's sources and tests (the
    // emit project above runs with `noCheck` because it only produces
    // declarations).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "types": ["node"],
    "rootDir": "."
  },
  "include": [
    "src",
    "tests"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../locale/tsconfig.client.json"
    }
  ]
}
