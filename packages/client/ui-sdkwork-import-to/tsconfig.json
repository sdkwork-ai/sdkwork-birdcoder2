{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The console api-keys view comes from the sibling sdkwork-cloudrouter
    // checkout as external source. It is written for the sdkwork flag set
    // (strict only), so the harness's stricter flags are relaxed for THIS
    // project's program; the package's own code still follows the harness
    // conventions.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    // The sibling source is type-checked by the dedicated tests project
    // (tsconfig.tests.json); this project resolves and emits declarations.
    "noCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../locale/tsconfig.client.json"
    }
  ]
}
