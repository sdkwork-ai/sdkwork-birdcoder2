{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // This no-emit program checks the real sibling source and catches drift in
    // the Membership/Order/Promotion PC surface and generated SDK clients.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "types": ["node"],
    "rootDir": "../../../..",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    // SDKWork packages use React 19 types. A single type identity keeps JSX
    // assignability coherent while BirdCoder still supplies React 18 at runtime.
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "../../../../sdkwork-membership/apps/sdkwork-membership-common/packages/sdkwork-membership-service/src",
    "../../../../sdkwork-membership/apps/sdkwork-membership-common/packages/sdkwork-membership-contracts/src",
    "../../../../sdkwork-membership/apps/sdkwork-membership-common/packages/sdkwork-membership-sdk-ports/src",
    "../../../../sdkwork-membership/apps/sdkwork-membership-pc/packages/sdkwork-membership-pc-core/src",
    "../../../../sdkwork-membership/apps/sdkwork-membership-pc/packages/sdkwork-membership-pc-membership/src",
    "../../../../sdkwork-membership/apps/sdkwork-membership-pc/packages/sdkwork-membership-pc-subscription/src",
    "../../../../sdkwork-membership/sdks/sdkwork-membership-app-sdk/sdkwork-membership-app-sdk-typescript/src",
    "../../../../sdkwork-membership/sdks/sdkwork-membership-app-sdk/sdkwork-membership-app-sdk-typescript/generated",
    "../../../../sdkwork-order/apps/sdkwork-order-common/packages/sdkwork-order-service/src",
    "../../../../sdkwork-order/apps/sdkwork-order-common/packages/sdkwork-order-contracts/src",
    "../../../../sdkwork-order/apps/sdkwork-order-common/packages/sdkwork-order-sdk-ports/src",
    "../../../../sdkwork-order/apps/sdkwork-order-pc/packages/sdkwork-order-pc-checkout/src",
    "../../../../sdkwork-order/apps/sdkwork-order-pc/packages/sdkwork-order-pc-recharge/src",
    "../../../../sdkwork-order/sdks/sdkwork-order-app-sdk/sdkwork-order-app-sdk-typescript/src",
    "../../../../sdkwork-order/sdks/sdkwork-order-app-sdk/sdkwork-order-app-sdk-typescript/generated",
    "../../../../sdkwork-promotion/apps/sdkwork-promotion-common/packages/sdkwork-promotion-service/src",
    "../../../../sdkwork-promotion/apps/sdkwork-promotion-common/packages/sdkwork-promotion-contracts/src",
    "../../../../sdkwork-promotion/apps/sdkwork-promotion-common/packages/sdkwork-promotion-sdk-ports/src",
    "../../../../sdkwork-promotion/apps/sdkwork-promotion-pc/packages/sdkwork-promotion-pc-core/src",
    "../../../../sdkwork-promotion/apps/sdkwork-promotion-pc/packages/sdkwork-promotion-pc-coupon/src",
    "../../../../sdkwork-promotion/sdks/sdkwork-promotion-app-sdk/sdkwork-promotion-app-sdk-typescript/src",
    "../../../../sdkwork-promotion/sdks/sdkwork-promotion-app-sdk/sdkwork-promotion-app-sdk-typescript/generated",
    "../../../../sdkwork-ui/sdkwork-ui-pc-react/src",
    "../../../../sdkwork-appbase/packages/pc-react/foundation/sdkwork-appbase-pc-react/src",
    "../../../../sdkwork-appbase/packages/pc-react/foundation/sdkwork-i18n-pc-react/src",
    "../../../../sdkwork-appbase/packages/common/foundation/sdkwork-runtime-bootstrap/src",
    "../../../../sdkwork-utils/packages/sdkwork-utils-typescript/src",
    "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src"
  ],
  "exclude": [
    "../../../../sdkwork-*/**/*.test.ts",
    "../../../../sdkwork-*/**/*.test.tsx",
    "../../../../sdkwork-*/**/*.spec.ts",
    "../../../../sdkwork-*/**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    { "path": "../../../vendor/cordis" },
    { "path": "../locale" },
    { "path": "../runtime" },
    { "path": "../ui-app-modes" },
    { "path": "../ui-env" },
    { "path": "../ui-iam" },
    { "path": "../ui-theme" },
    { "path": "../ui-layout" },
    { "path": "../ui-primitives" },
    { "path": "../ui-slots" },
    { "path": "../../runtime-diagnostics/invariants" }
  ]
}
