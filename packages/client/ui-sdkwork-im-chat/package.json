{
  "name": "@deepseek-ai/dsh-client-ui-sdkwork-im-chat",
  "description": "SDKWork IM conversation pane: fills the chat mode's im.chat.pane seat with sdkwork-im's conversation-window surface for the selected conversation",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sdkwork-im-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sdkwork-im",
        "@deepseek-ai/dsh-client-ui-sdkwork-im-conversations"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sdkwork-im": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sdkwork-im-conversations": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "^18.2.0",
    "react-i18next": "catalog:",
    "react-markdown": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
