{
  "name": "@deepseek-ai/dsh-client-ui-sdkwork-apikey",
  "description": "SDKWork cloudrouter API key management plugin: an independent wide modal (settings-menu popover row → settings.apiKeys seat) over the @sdkwork/cloudrouter-pc-console-api-keys ApiKeysView, with host-constructed app/models clients bound through the service's injectable seam",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sdkwork-apikey"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sdkwork-env",
        "@deepseek-ai/dsh-client-ui-sdkwork-iam"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sdkwork-env": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sdkwork-iam": "workspace:^",
    "@sdkwork/cloudrouter-app-sdk": "workspace:^",
    "@sdkwork/i18n-pc-react": "workspace:^",
    "@sdkwork/models-app-sdk": "workspace:^",
    "@sdkwork/sdk-common": "workspace:^",
    "@types/react": "~18.3.1",
    "i18next": "^26.4.1",
    "react": "^18.2.0",
    "react-i18next": "^17.0.13",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
