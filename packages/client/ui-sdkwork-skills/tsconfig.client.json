{
  // Client face of a split client package: the settings page, its store, and
  // the `skillPreferences` service it publishes. `src/skills-settings.ts` is
  // listed here as well as in tsconfig.host.json because both faces read the
  // namespace and field names; it is the only file the two share.
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/client",
    "src/skills-settings.ts",
    "src/css-modules.d.ts"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../locale"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../store"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../ui-renderer"
    },
    {
      "path": "../ui-settings"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../../api/remotes/tsconfig.client.json"
    },
    {
      "path": "../../api/session-controller/tsconfig.client.json"
    },
    {
      "path": "../../core/session"
    }
  ]
}
