{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The full typecheck project: checks ui-sdkwork-feedback's own code AND the
    // sdkwork sibling source it composes against (their exports point at
    // src, so node_modules resolution joins them as source). The emit
    // project (tsconfig.json) ships declarations with noCheck; this project
    // is the real gate and the drift guard for the sdkwork surface. noEmit
    // keeps the external source out of the declaration machinery
    // (declaration and declarationMap are off for the same reason — the
    // sdkwork closure cannot be named portably).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    // The sdkwork closure (sdk-common's utils) references Node globals.
    "types": ["node"],
    "rootDir": "../../../..",
    // TS 6.0 paths need baseUrl; ignoreDeprecations silences the 7.0
    // removal notice.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    // One React type identity for the whole program: the sdkwork sources
    // and their radix peers resolve react types from different workspace
    // trees (19 vs the harness root's 18), and the mixed identities break
    // JSX assignability. Map every react specifier to the ui-sdkwork-feedback
    // devDependency's @types/react 19.2.x (baseUrl anchors the paths).
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "src",
    "tests",
    // The sdkwork closure this program composes. Listed (and test files
    // excluded) so the composite-era file-list rule accepts the imported
    // sources; the packages themselves stay outside the project tree.
    "../../../../sdkwork-appstore/sdks/sdkwork-appstore-app-sdk/sdkwork-appstore-app-sdk-typescript/src",
    "../../../../sdkwork-appstore/sdks/sdkwork-appstore-app-sdk/sdkwork-appstore-app-sdk-typescript/generated",
    "../../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src",
    "../../../../sdkwork-utils/packages/sdkwork-utils-typescript/src"
  ],
  "exclude": [
    "../../../../sdkwork-*/**/*.test.ts",
    "../../../../sdkwork-*/**/*.test.tsx",
    "../../../../sdkwork-*/**/*.spec.ts",
    "../../../../sdkwork-*/**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../ui-slots"
    },
    {
      "path": "../ui-primitives"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../ui-layout"
    },
    {
      "path": "../ui-sdkwork-env"
    },
    {
      "path": "../ui-settings"
    },
    {
      "path": "../ui-sdkwork-settings-menu"
    },
    {
      "path": "../locale"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
