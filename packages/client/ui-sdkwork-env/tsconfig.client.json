{
  // Client face of a split client package: the `ctx.env` service and its
  // settings mirror. `src/env-settings.ts` is listed here as well as in
  // tsconfig.host.json because both faces read the namespace, the section
  // shape, and the page-global key; it is the only file the two share.
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/client",
    "src/env-settings.ts",
    "src/css-modules.d.ts"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../ui-settings/tsconfig.client.json"
    }
  ]
}
