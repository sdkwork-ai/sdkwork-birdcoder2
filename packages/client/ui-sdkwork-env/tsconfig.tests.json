{
  // Host-side check of the split package: the durable section declaration, the
  // projection, and the two specs that drive them. The browser half is checked
  // by the client test aggregate (tsconfig.client.tests.json), which lists the
  // client specs — the two programs merge cordis Context under the same keys,
  // so the Host half may not enter a client-flagged program.
  "extends": "./tsconfig.host.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "rootDir": "../../../..",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/env-projection.ts",
    "src/env-settings.ts",
    "tests/env-projection.host.spec.ts",
    "tests/settings.host.spec.ts"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../host/webserver"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../util/launch-environment"
    }
  ]
}
