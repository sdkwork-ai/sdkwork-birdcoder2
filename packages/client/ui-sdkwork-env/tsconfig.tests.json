{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noCheck": false,
    "rootDir": "../../../..",
    "types": ["node"]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../ui-settings"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
