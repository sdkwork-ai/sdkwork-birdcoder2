{
  "name": "@sdkwork/dsh-mcp-connector",
  "version": "0.1.0",
  "description": "SDKWork MCP connector: the connector marketplace served by the sdkwork-mcp application, plus local connections, OAuth/API-key authorization, the cross-connection tool workbench and connection diagnostics.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "ui",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@sdkwork/mcp-app-sdk": "workspace:*",
    "cross-spawn": "^7.0.6",
    "undici": "^6.29.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=20"
  }
}
